---
import Game from '../../layouts/Game.astro';
---
<Game
  title="Snake"
  blurb="The original. 20×20 grid, no mercy."
  description="Play Snake in the browser — keyboard or touch, 20×20 grid."
>
  <canvas id="board" width="400" height="400" aria-label="Snake game board"></canvas>
  <Fragment slot="controls">
    <label class="hud-control">Speed
      <select id="difficulty">
        <option value="easy">Easy</option>
        <option value="normal" selected>Normal</option>
        <option value="hard">Hard</option>
      </select>
    </label>
  </Fragment>
  <Fragment slot="help">Arrow keys / WASD to steer · swipe on touch · any key to start</Fragment>
</Game>

<style>
  #board {
    width: min(400px, 78vw);
    height: min(400px, 78vw);
    border: 1px solid var(--line-2);
    border-radius: 8px;
    touch-action: none;
  }
</style>

<script>
  const canvas = document.getElementById('board');
  const ctx = canvas.getContext('2d');
  const scoreEl = document.getElementById('score');
  const N = 20;
  const CELL = canvas.width / N;
  const diffEl = document.getElementById('difficulty');
  const TICK_MS = { easy: 150, normal: 110, hard: 78 };
  let snake, dir, nextDir, food, score, dead, timer;

  const css = (name) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();

  function reset() {
    snake = [{ x: 9, y: 10 }, { x: 8, y: 10 }, { x: 7, y: 10 }];
    dir = { x: 1, y: 0 };
    nextDir = dir;
    score = 0;
    dead = false;
    placeFood();
    scoreEl.textContent = '0';
    clearInterval(timer);
    timer = setInterval(tick, TICK_MS[diffEl.value] ?? 110);
    draw();
  }

  function placeFood() {
    do {
      food = { x: Math.floor(Math.random() * N), y: Math.floor(Math.random() * N) };
    } while (snake.some((s) => s.x === food.x && s.y === food.y));
  }

  function tick() {
    dir = nextDir;
    const head = { x: snake[0].x + dir.x, y: snake[0].y + dir.y };
    if (head.x < 0 || head.y < 0 || head.x >= N || head.y >= N || snake.some((s) => s.x === head.x && s.y === head.y)) {
      dead = true;
      clearInterval(timer);
      draw();
      return;
    }
    snake.unshift(head);
    if (head.x === food.x && head.y === food.y) {
      score += 10;
      scoreEl.textContent = String(score);
      placeFood();
    } else {
      snake.pop();
    }
    draw();
  }

  function draw() {
    ctx.fillStyle = css('--well');
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = css('--acc');
    ctx.beginPath();
    ctx.arc(food.x * CELL + CELL / 2, food.y * CELL + CELL / 2, CELL * 0.32, 0, Math.PI * 2);
    ctx.fill();
    snake.forEach((s, i) => {
      ctx.fillStyle = i === 0 ? css('--fg') : css('--fg-2');
      ctx.fillRect(s.x * CELL + 1.5, s.y * CELL + 1.5, CELL - 3, CELL - 3);
    });
    if (dead) {
      ctx.fillStyle = 'rgba(0,0,0,.55)';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#fff';
      ctx.font = `600 22px ${css('--mono')}`;
      ctx.textAlign = 'center';
      ctx.fillText('Game over — Restart to retry', canvas.width / 2, canvas.height / 2);
    }
  }

  const turns = {
    ArrowUp: { x: 0, y: -1 }, ArrowDown: { x: 0, y: 1 }, ArrowLeft: { x: -1, y: 0 }, ArrowRight: { x: 1, y: 0 },
    w: { x: 0, y: -1 }, s: { x: 0, y: 1 }, a: { x: -1, y: 0 }, d: { x: 1, y: 0 }
  };
  document.addEventListener('keydown', (e) => {
    const t = turns[e.key];
    if (!t) return;
    e.preventDefault();
    if (t.x !== -dir.x || t.y !== -dir.y) nextDir = t;
  });

  let touchStart = null;
  canvas.addEventListener('touchstart', (e) => (touchStart = e.touches[0]), { passive: true });
  canvas.addEventListener('touchend', (e) => {
    if (!touchStart) return;
    const dx = e.changedTouches[0].clientX - touchStart.clientX;
    const dy = e.changedTouches[0].clientY - touchStart.clientY;
    const t = Math.abs(dx) > Math.abs(dy) ? { x: Math.sign(dx), y: 0 } : { x: 0, y: Math.sign(dy) };
    if (t.x !== -dir.x || t.y !== -dir.y) nextDir = t;
    touchStart = null;
  });

  diffEl.addEventListener('change', reset);
  document.getElementById('restart').addEventListener('click', reset);
  reset();
</script>
