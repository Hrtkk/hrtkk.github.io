---
import Game from '../../layouts/Game.astro';
---
<Game
  title="Typing Test"
  blurb="Two, five, or ten minutes. The words-per-minute number doesn't lie."
  description="A timed typing test — 2, 5, or 10 minutes with live WPM, accuracy, and error stats."
>
  <div class="type-wrap">
    <div id="text" class="type-text" tabindex="0" aria-label="Typing area"></div>
    <input id="mobile-input" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" aria-hidden="true" />
    <div id="results" class="type-results" hidden>
      <p class="results-headline"><strong id="r-net">0</strong> WPM</p>
      <dl class="results-grid mono">
        <div><dt>Gross WPM</dt><dd id="r-gross">0</dd></div>
        <div><dt>Accuracy</dt><dd id="r-acc">0%</dd></div>
        <div><dt>Characters</dt><dd id="r-chars">0</dd></div>
        <div><dt>Errors</dt><dd id="r-errors">0</dd></div>
      </dl>
      <p class="results-note">Net WPM counts only correctly typed characters. Restart to go again.</p>
    </div>
  </div>
  <Fragment slot="controls">
    <label class="hud-control">Time
      <select id="duration">
        <option value="2" selected>2 min</option>
        <option value="5">5 min</option>
        <option value="10">10 min</option>
      </select>
    </label>
    <span class="hud-control">Left <strong id="timer">2:00</strong></span>
  </Fragment>
  <Fragment slot="help">Click the text and start typing · timer starts on your first key · Score is live net WPM</Fragment>
</Game>

<style>
  .type-wrap { position: relative; width: 100%; }
  .type-text {
    text-align: left;
    font-family: var(--mono);
    font-size: 16.5px;
    line-height: 2;
    color: var(--fg-3);
    max-height: 264px;
    overflow-y: auto;
    padding: 6px 10px;
    outline: none;
    cursor: text;
  }
  .type-text :global(span.ok) { color: var(--fg); }
  .type-text :global(span.err) {
    color: #e5484d;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .type-text :global(span.cur) {
    background: var(--acc-soft);
    box-shadow: inset -2px 0 0 var(--acc);
  }
  #mobile-input {
    position: absolute;
    opacity: 0;
    height: 1px;
    width: 1px;
    top: 0;
    left: 0;
    border: 0;
    padding: 0;
  }
  .type-results {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    background: var(--panel);
  }
  .results-headline {
    font-family: var(--serif);
    font-size: 24px;
    margin: 0;
  }
  .results-headline strong { color: var(--acc); font-size: 44px; }
  .results-grid {
    display: grid;
    grid-template-columns: repeat(4, auto);
    gap: 8px 28px;
    margin: 0;
    font-size: 13px;
  }
  .results-grid dt { color: var(--fg-3); }
  .results-grid dd { margin: 4px 0 0; color: var(--fg); font-weight: 700; font-size: 16px; }
  .results-note { color: var(--fg-3); font-size: 12.5px; margin: 0; }
  @media (max-width: 560px) {
    .results-grid { grid-template-columns: repeat(2, auto); }
  }
</style>

<script>
  const textEl = document.getElementById('text');
  const resultsEl = document.getElementById('results');
  const scoreEl = document.getElementById('score');
  const timerEl = document.getElementById('timer');
  const durationEl = document.getElementById('duration');
  const mobileInput = document.getElementById('mobile-input');

  const PARAS = [
    'The best way to get faster at typing is the same as the best way to get faster at anything: slow down until you stop making mistakes, then let speed arrive on its own. Accuracy compounds, and every correction costs more time than the error saved.',
    'A distributed system is one in which the failure of a computer you did not even know existed can render your own computer unusable. The trick is not avoiding failure but designing so that failure is ordinary, observable, and survivable.',
    'Streams of data flow through modern software the way rivers flow through old cities. Everything interesting happens at the banks, where the flow is diverted, filtered, joined with other streams, and finally delivered somewhere it becomes useful.',
    'Caches are a deal with the devil. You trade correctness risk for speed, and the interest on that loan is paid in invalidation bugs. Still, almost every fast system you admire has made this exact trade somewhere under the hood.',
    'Good code reads like a well kept notebook. The naming is boring in the best way, each function does the one thing its name promises, and nothing clever happens without a comment explaining why the cleverness earns its place.',
    'The keyboard is the closest thing a programmer has to a musical instrument. Nobody judges a pianist for practicing scales, so nobody should judge an engineer for spending ten minutes a day just typing, deliberately and precisely.',
    'Logs tell you what happened, metrics tell you how often, and traces tell you where the time went. A system with all three is a system you can debug at three in the morning without waking anyone else up.',
    'Every queue in production is a promise that the future will have spare capacity. Sometimes the future keeps that promise, and sometimes the queue grows until someone gets paged. Back pressure is just honesty between services.'
  ];

  let queue, chars, idx, typed, errors, startTime, timerId, finished, secondsLeft;

  const shuffled = () => [...PARAS].sort(() => Math.random() - 0.5);
  const fmt = (s) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
  const minutes = () => parseInt(durationEl.value, 10);

  function appendPara() {
    const text = (chars.length ? ' ' : '') + (queue.length ? queue.shift() : shuffled()[0]);
    for (const ch of text) {
      const span = document.createElement('span');
      span.textContent = ch;
      textEl.appendChild(span);
      chars.push(span);
    }
  }

  function reset() {
    queue = shuffled();
    chars = [];
    idx = 0;
    typed = 0;
    errors = 0;
    startTime = null;
    finished = false;
    secondsLeft = minutes() * 60;
    clearInterval(timerId);
    textEl.innerHTML = '';
    resultsEl.hidden = true;
    scoreEl.textContent = '0';
    timerEl.textContent = fmt(secondsLeft);
    appendPara();
    appendPara();
    setCaret();
  }

  function setCaret() {
    chars[idx]?.classList.add('cur');
    const cur = chars[idx];
    if (cur && cur.offsetTop > textEl.scrollTop + textEl.clientHeight - 70) {
      textEl.scrollTop = cur.offsetTop - 60;
    }
  }

  function liveWpm() {
    if (!startTime) return 0;
    const mins = Math.max((Date.now() - startTime) / 60000, 1 / 60);
    return Math.round((typed - errors) / 5 / mins);
  }

  function startTimer() {
    startTime = Date.now();
    timerId = setInterval(() => {
      secondsLeft -= 1;
      timerEl.textContent = fmt(Math.max(secondsLeft, 0));
      scoreEl.textContent = String(liveWpm());
      if (secondsLeft <= 0) finish();
    }, 1000);
  }

  function finish() {
    finished = true;
    clearInterval(timerId);
    const mins = minutes();
    const net = Math.round((typed - errors) / 5 / mins);
    const gross = Math.round(typed / 5 / mins);
    const acc = typed ? Math.round(((typed - errors) / typed) * 100) : 0;
    document.getElementById('r-net').textContent = String(Math.max(net, 0));
    document.getElementById('r-gross').textContent = String(gross);
    document.getElementById('r-acc').textContent = `${acc}%`;
    document.getElementById('r-chars').textContent = String(typed);
    document.getElementById('r-errors').textContent = String(errors);
    scoreEl.textContent = String(Math.max(net, 0));
    resultsEl.hidden = false;
  }

  function onKey(e) {
    if (finished || e.metaKey || e.ctrlKey || e.altKey) return;

    if (e.key === 'Backspace') {
      e.preventDefault();
      if (idx === 0) return;
      chars[idx]?.classList.remove('cur');
      idx -= 1;
      const span = chars[idx];
      if (span.classList.contains('err')) errors -= 1;
      span.classList.remove('ok', 'err');
      typed -= 1;
      setCaret();
      return;
    }

    if (e.key.length !== 1) return;
    e.preventDefault();
    if (!startTime) startTimer();

    const span = chars[idx];
    if (!span) return;
    const good = e.key === span.textContent;
    span.classList.remove('cur');
    span.classList.add(good ? 'ok' : 'err');
    if (!good) errors += 1;
    typed += 1;
    idx += 1;
    if (chars.length - idx < 140) appendPara();
    setCaret();
  }

  document.addEventListener('keydown', onKey);
  textEl.addEventListener('click', () => mobileInput.focus({ preventScroll: true }));
  durationEl.addEventListener('change', reset);
  document.getElementById('restart').addEventListener('click', reset);
  reset();
</script>
