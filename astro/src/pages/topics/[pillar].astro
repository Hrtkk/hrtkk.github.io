---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import Newsletter from '../../components/Newsletter.astro';
import { sortedPosts } from '../../utils.js';
import { PILLARS } from '../../pillars.js';

export async function getStaticPaths() {
  return PILLARS.map((pillar) => ({ params: { pillar: pillar.slug }, props: { pillar } }));
}

const { pillar } = Astro.props;
const posts = sortedPosts(await getCollection('blog', (p) => p.data.pillar === pillar.slug));
---
<Base title={pillar.label} description={pillar.blurb}>
  <div class="container">
    <header class="topic-header">
      <p class="back-link mono"><a href="/blog/">← All articles</a></p>
      <h1>{pillar.label}</h1>
      <p class="topic-blurb">{pillar.blurb}</p>
    </header>

    {posts.length > 0 ? (
      <div class="topic-list">
        {posts.map((post) => <PostRow post={post} />)}
      </div>
    ) : (
      <p class="topic-empty panel">
        Nothing published here yet — new videos and posts land every two weeks.
        Subscribe below and you'll get the first one.
      </p>
    )}

    <Newsletter compact={posts.length === 0} />
  </div>
</Base>

<style>
  .topic-header { padding: 56px 0 8px; }
  .topic-header h1 { font-size: clamp(36px, 5vw, 48px); }
  .back-link { font-size: 12.5px; margin: 0 0 18px; }
  .back-link a { color: var(--fg-3); text-decoration: none; }
  .back-link a:hover { color: var(--acc); }
  .topic-blurb { color: var(--fg-2); font-size: 17px; max-width: 46em; margin: 12px 0 26px; }
  .topic-list { margin-top: 10px; }
  .topic-list :global(.post-row:first-child) { border-top: 0; }
  .topic-empty { padding: 26px 28px; color: var(--fg-2); max-width: 46em; }
</style>
